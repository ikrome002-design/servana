<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- force=true so these override real container env vars (docker-compose
             sets CACHE_STORE/SESSION_DRIVER/etc.); without it tests would hit the
             shared redis cache and the rate limiters would bleed across runs. -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <!-- <env name="DB_CONNECTION" value="sqlite"/> -->
        <!-- <env name="DB_DATABASE" value=":memory:"/> -->
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <!-- Phase 22 (D-22-02): Scout's NullEngine by default, so the pre-existing
             suite acquires zero search-indexing coupling — no network call to
             Meilisearch, no async-index wait, no behaviour change. The Phase 22
             tests that must prove real engine behaviour opt in explicitly and
             REQUIRE a reachable engine (they fail, never skip, without one — the
             CI Backend job runs a getmeili/meilisearch:v1.10 service for exactly
             this reason, and the dev stack already runs one). -->
        <env name="SCOUT_DRIVER" value="null" force="true"/>
        <env name="SCOUT_PREFIX" value="servana_testing_" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <!-- Phase UI-03: SANCTUM_STATEFUL_DOMAINS is deliberately NOT overridden here. It is
             derived in config/sanctum.php from the canonical account-host registry (all eight
             accounts x three environments, bare and with the local port) plus the loopback
             origins. Forcing it to `localhost` — as this file used to — made every account host
             non-stateful under test, so a Magic Link verify on `finance.servana.test` returned
             200 with NO session cookie and the host-scoped session tests could not exist. -->
        <env name="ACCOUNT_HOST_LOCAL_PORT" value="8080" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
