{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "citrus-labs/servana",
    "type": "project",
    "description": "Servana by Citrus - multi-tenant service-operations SaaS for African service-based SMEs.",
    "keywords": ["servana", "citrus", "saas", "laravel"],
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "dedoc/scramble": "^0.13.28",
        "laravel/framework": "^12.61.1",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^2.9",
        "league/flysystem-aws-s3-v3": "^3.0",
        "pragmarx/google2fa": "^8.0",
        "sentry/sentry-laravel": "^4.10"
    },
    "require-dev": {
        "brianium/paratest": "^7.4",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/pail": "^1.1",
        "laravel/pint": "^1.13",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "pestphp/pest": "^3.5",
        "pestphp/pest-plugin-laravel": "^3.0",
        "symfony/yaml": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "pint": "pint",
        "stan": [
            "Composer\\Config::disableProcessTimeout",
            "phpstan analyse --memory-limit=512M"
        ],
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "api:openapi": [
            "@php artisan servana:openapi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.3.31"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
