# ==============================================================================

/public/build/
/public/spa/
/public/hot
/public/mix-manifest.json
/public/js/
/public/css/

# Only ignore public JS/CSS above if they are generated.
# Keep source files inside resources/js, resources/css, resources/views.

.vite/
vite.config.*.timestamp-*
vite.config.*.local.*

dist/
build/
out/

*.tsbuildinfo


