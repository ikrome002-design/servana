# ==============================================================================
# Servana by Citrus - .gitignore
# Service-operations SaaS by Citrus Labs Limited
#
# Stack assumption:
# - Laravel / PHP backend
# - Vue.js or React.js frontend
# - JavaScript / TypeScript
# - Vite
# - Tailwind CSS or Bootstrap 5
# - MySQL or PostgreSQL
#
# Security position:
# Never commit secrets, tenant data, payment records, exports, logs, generated
# invoices/receipts, database dumps, or local environment files.
# ==============================================================================


# ==============================================================================
# 1. Environment files and secrets
# ==============================================================================

.env
.env.*
!.env.example

# Laravel / application secrets
*.key
*.pem
*.crt
*.csr
*.p12
*.pfx
*.jks
*.keystore

# Local secret/config files
secrets/
secret/
private/
credentials/
certs/
keys/

# Cloud/service credentials
google-credentials.json
firebase-credentials.json
firebase-service-account*.json
service-account*.json
aws-credentials.json
gcp-credentials.json
azure-credentials.json

# Payment gateway credentials/config dumps
mpesa-credentials.json
mpesa-secrets.json
daraja-credentials.json
stripe-credentials.json
paystack-credentials.json
flutterwave-credentials.json
pesapal-credentials.json
payment-gateway-credentials.json

# OAuth / API local credentials
oauth-credentials.json
oauth-client-secret.json
client_secret*.json

# Local encrypted values or decrypted config snapshots
*.secret
*.secrets
*.vault
*.enc.local
*.decrypted


# ==============================================================================
# 2. PHP / Composer dependencies
# ==============================================================================

/vendor/

# Keep composer.lock committed for app repositories.
# Do NOT ignore composer.lock unless this repository becomes a reusable package.
# composer.lock


# ==============================================================================
