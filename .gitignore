# ==============================================================================
# 18. Files that should usually remain tracked
# ==============================================================================

# Keep these committed:
# - composer.json
# - composer.lock
# - package.json
# - package-lock.json / pnpm-lock.yaml / yarn.lock / bun.lockb
# - vite.config.js / vite.config.ts
# - tailwind.config.js / tailwind.config.ts
# - postcss.config.js
# - tsconfig.json
# - phpunit.xml or phpunit.xml.dist, provided it contains no secrets
# - .env.example
# - database/migrations/
# - database/seeders/
# - database/factories/
# - routes/
# - app/
# - resources/
# - config/, provided secrets are referenced through env()
# - tests/
# - README.md
# - LICENSE

# ==============================================================================
# 14. Source-code overrides (MUST stay last to win over the broad runtime
# business-data folder names above, e.g. receipts/, reports/, exports/).
# Application domain source under app/Domain is always tracked.
# ==============================================================================
!/app/Domain/**/
!/app/Domain/**
