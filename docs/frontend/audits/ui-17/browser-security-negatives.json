    {
      "probe": "source map <entry>.map",
      "expected": "404"
    },
    {
      "probe": "/spa/.vite/manifest.json",
      "expected": "301 (never the private manifest)"
    },
    {
      "probe": "/.env, /.git/config, /storage/../.env",
      "expected": "400/403/404"
    },
    {
      "probe": "context handoff with a synthetic token /auth/switch?token=<synthetic>",
      "expected": "302, exactly one Referrer-Policy: no-referrer, Cache-Control no-store; token absent from edge log"
    }
