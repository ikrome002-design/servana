{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://citrus.co.ke/servana/refer-earn/schemas/merchant.identity_snapshot_changed.v1.json",
  "title": "merchant.identity_snapshot_changed (v1) — Merchant legal/business identity profile changed",
  "description": "Emitted when the merchant's legal/business identity fields change. Carries a SHA-256 snapshot hash and a changed-field COUNT — never the legal name, registration identifiers, document contents or any raw field value (Plan §58B.1 'snapshot hash, not raw documents'). additionalProperties is false: a payload builder that starts leaking a new field fails this schema in CI rather than in production.",
  "type": "object",
  "properties": {
    "product_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16
    },
    "environment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "merchant_public_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "sequence_no": {
      "type": "integer",
      "minimum": 1
    },
    "schema_version": {
      "const": "1"
    },
    "merchant_status": {
      "type": "string",
      "enum": [
        "pending_setup",
        "active",
        "suspended",
        "deactivated"
      ]
    },
    "identity_snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "changed_field_count": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "product_code",
    "environment",
    "merchant_public_id",
    "event_id",
    "occurred_at",
    "sequence_no",
    "schema_version",
    "merchant_status",
    "identity_snapshot_sha256",
    "changed_field_count"
  ],
  "additionalProperties": false
}
