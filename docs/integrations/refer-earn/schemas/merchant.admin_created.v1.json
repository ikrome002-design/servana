{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://citrus.co.ke/servana/refer-earn/schemas/merchant.admin_created.v1.json",
  "title": "merchant.admin_created (v1) — Founding merchant_admin membership created",
  "description": "Emitted in the SAME registration transaction as merchant.registration_started, once the founding merchant_admin membership row exists. Carries the role LABEL only — no user name, email, phone or identifier of any kind (Plan §58B.2 forbids staff/admin PII). additionalProperties is false: a payload builder that starts leaking a new field fails this schema in CI rather than in production.",
  "type": "object",
  "properties": {
    "product_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16
    },
    "environment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "merchant_public_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "sequence_no": {
      "type": "integer",
      "minimum": 1
    },
    "schema_version": {
      "const": "1"
    },
    "merchant_status": {
      "type": "string",
      "enum": [
        "pending_setup",
        "active",
        "suspended",
        "deactivated"
      ]
    },
    "admin_role": {
      "const": "merchant_admin"
    }
  },
  "required": [
    "product_code",
    "environment",
    "merchant_public_id",
    "event_id",
    "occurred_at",
    "sequence_no",
    "schema_version",
    "merchant_status",
    "admin_role"
  ],
  "additionalProperties": false
}
