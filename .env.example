# ==============================================================================
# Servana by Citrus - environment template (Phase 1)
# Copy to .env and run `php artisan key:generate`.
# NEVER put real secrets here. .env is gitignored; .env.example holds
# placeholders only (CLAUDE.md §6.4). The full, documented variable set
# (mail, S3/MinIO, Redis, Meilisearch, M-Pesa, Sentry, etc.) is added in
# Phase 2 alongside Docker.
# ==============================================================================

APP_NAME=Servana
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Timestamps are stored UTC; merchant business-day logic uses Africa/Nairobi
# (Plan AS-3). Keep the framework timezone UTC.
APP_TIMEZONE=UTC
APP_BUSINESS_TIMEZONE=Africa/Nairobi

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_KE

# Currency is KES, stored as integer minor units (Plan AS-3).
APP_CURRENCY=KES

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# PostgreSQL 16 (Plan AS-1). Provisioned via Docker in Phase 2; tests run on a
# PostgreSQL service container, never SQLite (CLAUDE.md §6.13).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=servana
DB_USERNAME=servana
DB_PASSWORD=

# Driven by the database until Redis arrives in Phase 2.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
QUEUE_CONNECTION=database

# Magic Link only (Plan A3). No mail transport is wired until Phase 2 (Mailpit);
# log driver keeps Phase 1 self-contained.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@servana.test"
MAIL_FROM_NAME="${APP_NAME}"

# SPA origin for CORS / Sanctum stateful domains (configured in later phases).
FRONTEND_URL=http://localhost:5173

VITE_APP_NAME="${APP_NAME}"
