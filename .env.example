# ==============================================================================
# Servana by Citrus - environment template
# Copy to .env (the Docker stack does this automatically on first `make up`).
#
# PLACEHOLDERS ONLY. Never commit real secrets — .env is gitignored (CLAUDE.md
# §6.4). Hostnames below match the docker-compose.yml service names so the app
# works out of the box inside the dev stack. Running artisan OUTSIDE Docker?
# Change the *_HOST values to 127.0.0.1.
# ==============================================================================

APP_NAME=Servana
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Timestamps are stored UTC; merchant business-day logic uses Africa/Nairobi
# (Plan AS-3).
APP_TIMEZONE=UTC
APP_BUSINESS_TIMEZONE=Africa/Nairobi

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_KE

# ------------------------------------------------------------------------------
# Account hosts (Phase UI-02; ADR-016, ADR-017)
# ------------------------------------------------------------------------------
# Servana serves EIGHT account experiences from one application, one per host.
# The canonical map lives in config/account-hosts.json; the values below only
# select which DOMAIN each environment uses and how absolute URLs are built.
#
# Local hostnames need Windows hosts-file entries — see
# docs/frontend/hosts/local-account-hosts.md. Never edit the hosts file from the
# application, and never require administrator elevation at runtime.
#
# THE HOST IS NEVER AUTHORIZATION. It selects the experience; identity,
# membership, tenant, branch, role, permission and MFA are always re-evaluated
# server-side from the database.

ACCOUNT_HOST_PRODUCTION_DOMAIN=servana.ke
ACCOUNT_HOST_LOCAL_DOMAIN=servana.test
# Staging hosts are DERIVED as {subdomain.}servana.{suffix} — environment
# configuration, never hard-coded business logic.
ACCOUNT_HOST_STAGING_SUFFIX=staging.citruslabs.co.ke

ACCOUNT_HOST_PRODUCTION_SCHEME=https
ACCOUNT_HOST_STAGING_SCHEME=https
ACCOUNT_HOST_LOCAL_SCHEME=http
# Published container port used when generating local absolute URLs. Leave empty
# for a default-port origin.
ACCOUNT_HOST_LOCAL_PORT=8080

# Hosts allowed to reach the app for MACHINE traffic only (container liveness,
# in-network calls). Modelled SEPARATELY from the eight account hosts — a machine
# host is not a ninth account and never resolves to an account experience.
ACCOUNT_HOST_MACHINE_HOSTS=localhost,127.0.0.1,app,nginx

# Reverse proxies whose X-Forwarded-* headers may be trusted. EMPTY means trust
# nothing, which makes Laravel ignore a forwarded host entirely — the safe
# default, and the one the test suite runs under. Set it to the edge's address
# (or `*` only when the app is unreachable except through a trusted proxy).
TRUSTED_PROXIES=

# Vite dev server / HMR. The dev server uses an EXPLICIT allowed-host list built
# from config/account-hosts.json — never `allowedHosts: true`.
VITE_DEV_HOST=localhost
VITE_DEV_PORT=5173
# Set VITE_HMR_HOST to the account host you are developing against when the HMR
# socket must reach the browser on that hostname.
VITE_HMR_HOST=
VITE_HMR_PORT=
VITE_HMR_PROTOCOL=

# Currency is KES, stored as integer minor units (Plan AS-3).
APP_CURRENCY=KES

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# Database — PostgreSQL 16 (Plan AS-1). Tests run on PostgreSQL, never SQLite
# (CLAUDE.md §6.13). `postgres` is the compose service hostname.
# ------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=servana
DB_USERNAME=servana
# Local dev password only — NOT a secret. Replace in every real environment.
DB_PASSWORD=secret

# ------------------------------------------------------------------------------
# Redis 7 — cache, queue, locks (Plan §4.1). `redis` is the compose hostname.
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_CLIENT=phpredis

# Prod intent (Plan §26.2): cache+queue on Redis, sessions in the database.
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
# Absolute session lifetime 8h (Plan §9.2); idle timeout below is sliding.
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
# Set true behind HTTPS in staging/production.
SESSION_SECURE_COOKIE=false
# Idle timeout in minutes — log out after this long with no requests (Plan §9.2).
AUTH_IDLE_TIMEOUT_MINUTES=60
# Enforce Magic Link eligibility checks 2 & 4 (active merchant membership / role).
# Enabled in Phase 6 now the merchant_users schema exists (Scope §2.3). Check 6
# (branch assignment) remains deferred to Phase 7. Set false only for diagnostics.
AUTH_ENFORCE_TENANCY_ELIGIBILITY=true

# MFA / step-up (Plan §18, Phase R3). TOTP is mandatory for Super Administrator,
# Merchant Administrator and Finance. step-up window = how long an MFA assertion
# stays "fresh" for designated sensitive actions (conservative 5-min default).
MFA_TOTP_ISSUER=Servana
MFA_TOTP_WINDOW=1
MFA_RECOVERY_CODE_COUNT=10
MFA_STEP_UP_WINDOW_MINUTES=5

# Idempotency / replay protection (Plan §24.4, ADR-003, Phase R4). Lock TTL is how
# long a single execution holds its claim before an identical request may recover
# it. Standard completed records are pruned after retention_hours; support-retriable
# financial records after retriable_retention_days. Active locks are never pruned.
IDEMPOTENCY_LOCK_TTL_SECONDS=30
IDEMPOTENCY_RETENTION_HOURS=72
IDEMPOTENCY_RETRIABLE_RETENTION_DAYS=30
IDEMPOTENCY_PRUNE_BATCH=1000

# ------------------------------------------------------------------------------
# Mail — Mailpit in dev (catches all outbound mail; UI at http://localhost:8025)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@servana.test"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# Object storage — S3-compatible. MinIO in dev (API http://localhost:9100,
# console http://localhost:9101). Private buckets + signed URLs only (Plan §19).
# Default disk stays `local`; the upload pipeline targets the `s3` disk below
# and is wired in Phase 19.
# ------------------------------------------------------------------------------
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=servana
AWS_SECRET_ACCESS_KEY=servana_secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=servana
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# ------------------------------------------------------------------------------
# Search — Meilisearch via Laravel Scout (Plan §68; wired in Phase 22).
#
# SERVER-ONLY. These values are read by config/scout.php and consumed by the API
# container and the queue workers. They are never published to a VITE_* variable, a
# Resource, the OpenAPI document, the generated TypeScript contract, or a log line —
# the SPA calls GET /api/v1/search and never the engine
# (docs/architecture/search/search-security.md §5).
#
# The test suite forces SCOUT_DRIVER=null (phpunit.xml), so the pre-existing suite has
# zero indexing coupling; only the Phase 22 engine tests opt in.
# ------------------------------------------------------------------------------
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
# Dev master key only — replace in real environments.
MEILISEARCH_KEY=masterKey
# Index prefix, environment-derived so no two environments can share an index.
# SCOUT_PREFIX=servana_local_
# Indexing runs on its own queue: a search index is never on the critical path of a
# business write, and a slow engine must not slow a financial transaction (Plan §72).
# SCOUT_QUEUE_NAME=search-index

# ------------------------------------------------------------------------------
# Antivirus — ClamAV (opt-in dev profile). Upload scanning wired in Phase 23.
# ------------------------------------------------------------------------------
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ------------------------------------------------------------------------------
# Clients — contact blind-index key (Plan §35; Phase 15A). Keyed HMAC over the
# normalized phone for branch-scoped search + duplicate prevention WITHOUT a
# plaintext index. Generate a fresh 32-byte base64 secret per environment, e.g.
#   php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
# Leave empty in local/CI to fall back to an APP_KEY-derived key; production MUST
# set this explicitly. NEVER commit a real value, log it, or expose it via API.
# ------------------------------------------------------------------------------
CLIENT_CONTACT_INDEX_KEY=

# ------------------------------------------------------------------------------
# SPA / auth — Sanctum stateful domains + CORS (configured fully from Phase 5).
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:8080
SANCTUM_STATEFUL_DOMAINS=localhost:8080,localhost:5173
SESSION_DOMAIN=localhost

# ------------------------------------------------------------------------------
# Error tracking — Sentry (Plan §22.1). Empty DSN disables delivery (local/CI);
# set a real DSN per environment in staging/production secrets only.
# PII scrubbing stays on (do not send default PII).
# ------------------------------------------------------------------------------
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_SEND_DEFAULT_PII=false

# ------------------------------------------------------------------------------
# Citrus Refer & Earn integration (Plan §58A, §17.1, §9 rules 22-24; ADR-013/015;
# Phase 21R-A). Servana is a SOURCE PRODUCT here: it captures referrals at
# registration and emits signed merchant facts. It owns no reward logic.
#
# EVERY VALUE BELOW IS A PLACEHOLDER. No real credential is ever committed, and
# nothing here has a working default: with REFER_EARN_ENABLED=false (or any piece
# of the signing contract missing) the deterministic FakeReferEarnClient is bound,
# so CI and local runs physically cannot reach a live partner (Plan §81 rule 21).
#
# Referral capture and outbox emission happen regardless — the local evidence must
# survive whether or not delivery is configured — and merchant registration is
# NEVER blocked by R&E (Plan A-19).
#
# Real secrets live only in the secrets manager under
# servana/{env}/refer-earn/signing_key_{key_id}, are disjoint per environment, and
# are never logged (Plan §9 rule 24, §24.5). The rotation runbook
# (docs/runbooks/rotate-re-signing-key.md, Plan §77.1) does not exist yet — the
# runbook set and the staging rotation drill are Phase 25 deliverables.
#
# The signing ALGORITHM is deliberately unset: ADR-015 forbids hardcoding
# HMAC-SHA-256 without an authoritative contract pin, and CitrusEventSigner throws
# rather than guessing. Pin status: docs/integrations/refer-earn/contract-pins.md.
# ------------------------------------------------------------------------------
REFER_EARN_ENABLED=false
REFER_EARN_PRODUCT_CODE=SRV
REFER_EARN_BASE_URL=
REFER_EARN_SIGNING_ALGORITHM=
REFER_EARN_SIGNING_KEY_ID=
REFER_EARN_SIGNING_SECRET=

# ------------------------------------------------------------------------------
# Personnel bulk SMS (Plan §64, §20, §24.5; ADR-010; Phase 21S)
#
# EVERY VALUE BELOW IS A PLACEHOLDER. No real credential is ever committed, and
# nothing here has a working default: with SMS_ENABLED=false (or any credential
# missing) the deterministic FakeSmsProviderClient is bound, and the `testing`
# environment binds it unconditionally — so CI and local runs physically cannot
# reach a live provider (Plan §81 rule 21).
#
# The Plan pins NO SMS provider, so the provider, its result-code map, its
# per-segment tariff and its delivery-receipt contract are all UNVERIFIED and are
# tracked by REM-SMS-002, which must close before Phase 25. NO delivery-receipt
# endpoint ships: Plan §24.1 forbids an unverifiable provider webhook.
#
# Real secrets live only in the secrets manager, are disjoint per environment, and
# are never logged (Plan §9 rule 24, §24.5). A provider response is redacted before
# it is stored, and the database additionally rejects any stored provider message
# containing a run of 7+ digits — no subscriber number can leak back in.
#
# The pricing and limit values are TARIFF/POLICY placeholders, not secrets: they
# are configuration so re-pricing is a config change, not a code change.
# ------------------------------------------------------------------------------
SMS_ENABLED=false
SMS_PROVIDER=fake
SMS_BASE_URL=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_CONTRACT_VERSION=
SMS_DELIVERY_RECEIPTS_ENABLED=false
SMS_MAX_RECIPIENTS_PER_CAMPAIGN=200
SMS_MAX_MESSAGE_CHARACTERS=480
SMS_UNIT_COST_MINOR=100
SMS_CURRENCY=KES

VITE_APP_NAME="${APP_NAME}"
